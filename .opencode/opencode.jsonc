{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "spark-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Spark-X2.5-4B (GPU local)",
      "options": {
        "baseURL": "http://localhost:8080/v1"
      },
      "models": {
        "spark-x2.5-4b": {
          "name": "Spark-X2.5-4B (GPU)",
          "reasoning": false,
          "tool_call": false,
          "limit": {
            "context": 4096,
            "output": 512
          }
        }
      }
    }
  },
  "agents": {
    "system-one": {
      "description": "Structured decision making via System One Lite. Uses Zod schemas for zero-parse-error typed outputs. Workflows: issue_triage, code_review, release_readiness.",
      "mode": "subagent",
      "type": "system-one",
      "steps": 3,
      "permission": {
        "bash": "allow",
        "read": "allow",
        "edit": "deny",
        "question": "deny"
      }
    }
  },
  "permission": {
    "bash": "allow"
  },
  "references": {
    "effect": {
      "repository": "github.com/Effect-TS/effect-smol",
      "description": "Use for Effect v4 and effect-smol implementation details"
    },
    "opencode-local": {
      "path": "~/.local/share/opencode",
      "description": "Contains opencode logs and data"
    }
  },
  "experimental": { "stream_delay": 50 },
  "mcp": {},
  "tools": {
    "github-triage": false,
    "github-pr-search": false
  }
}
